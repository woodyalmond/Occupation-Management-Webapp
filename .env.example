# alarmapp API (Python WAS) - RDS MySQL 연결
# 실제 값은 EC2 또는 Docker 환경에만 두고 git에는 올리지 마세요.

MYSQL_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=alarmapp
MYSQL_USER=admin
MYSQL_PASSWORD=your-password

API_HOST=0.0.0.0
API_PORT=8000

# Daily Note Markdown 저장 경로 (선택)
DAILYNOTE_DIR=/home/ubuntu/dailynote
